# =====================================================================
# Project Odysseus — environment configuration
#
# Copy this file to .env in the same directory and fill in the values.
# .env is gitignored and must NEVER be committed.
#
# This is the ONLY file the server admin needs to edit. Everything else
# is in version control.
#
# Location: the repository root - the folder that contains README.md and
# the app/, config/ and db/ folders. NOT inside public_html.
# =====================================================================


# ---------------------------------------------------------------------
# Database
#
# Create THREE databases in hPanel -> Databases. Hostinger prepends your
# account id to whatever name you type, and shows you the full result:
#
#     odys_core       ->  u123456789_odys_core
#     odys_ev_2026    ->  u123456789_odys_ev_2026
#     odys_ev_2027    ->  u123456789_odys_ev_2027
#
# Hostinger issues ONE credential per database, so each gets its own user.
# That is fine - see the per-shard credentials section below. If your host
# allows one user across several databases, that works too.
# ---------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASS=

# Full database names, exactly as hPanel shows them (including the account
# prefix). Copy and paste them.
#
#   DB_CORE   the permanent database: stores, orders, customers, reports
#   DB_SHARD  raw pixel events, which get a NEW database every year because
#             Hostinger caps each one at 3 GB. Keep the literal {year} in
#             this value - the application substitutes it to work out which
#             database a given date belongs to, and to check whether next
#             year's exists yet.
#
# Example, if your account prefix is u123456789_ :
#   DB_CORE=u123456789_odys_core
#   DB_SHARD=u123456789_odys_ev_{year}
#
DB_CORE=
DB_SHARD=


# ---------------------------------------------------------------------
# Per-shard credentials
#
# Hostinger issues ONE credential per database, so each yearly events
# database normally has its own user and password. Add a block per year:
#
#   DB_SHARD_2026_USER=u123456789_ev26
#   DB_SHARD_2026_PASS=...
#
# Optionally override the name too, if the database ended up called
# something that does not match the DB_SHARD pattern:
#
#   DB_SHARD_2026_NAME=u123456789_events_2026
#
# If a year has no block here, the application falls back to DB_USER /
# DB_PASS above. That covers hosts which allow one user across several
# databases.
#
# The databases do NOT need to share a user. No query ever JOINs across
# databases: event rows store only integer ids, and the names they point
# at live in DB_CORE, so each database is read on its own connection.
# ---------------------------------------------------------------------


# ---------------------------------------------------------------------
# Runtime data locations
#
# LEAVE BOTH BLANK unless you have a specific reason not to.
#
# The default is a folder named odysseus-data sitting beside the deployed
# code, e.g. /home/<account>/domains/<your-site>/odysseus-data. That is
# already correct: outside the repository, so a deploy cannot delete it, and
# above the document root, so it cannot be fetched over HTTP.
#
# Setting them by hand is the main way this goes wrong - it is easy to end
# up a directory higher than intended, and nothing complains, because the
# value is used exactly as written.
#
# What lives there, and why the location matters:
#   secrets/master.key   decrypts every stored Shopify token. Lose it and
#                        every store has to be re-onboarded. Expose it and
#                        every client's Shopify account is readable.
#   storage/spool/       pixel events accepted but not yet imported. Orders
#                        can be re-fetched from Shopify at any time. Pixel
#                        events cannot be recovered from anywhere, ever.
#
# If you do set them, any location works that is:
#   - outside the repository        (a deploy cannot delete it)
#   - outside every document root   (it cannot be served over HTTP)
#   - writable by PHP               (inside open_basedir, if the host sets one)
#
# Either way you never create the folders by hand - press "Create runtime
# directories" on the setup page and it builds the whole tree, parents
# included. The page also prints the paths it resolved, so you can confirm
# where they went.
# ---------------------------------------------------------------------
# STORAGE_PATH=   (leave blank unless you need a non-standard location)
# SECRETS_PATH=   (leave blank unless you need a non-standard location)


# ---------------------------------------------------------------------
# Setup token
#
# Only needed on hosts with no shell access, where the one-time setup steps
# have to run through the browser at /setup.php instead of the command line.
#
# That page can create files and change the database, so it is INERT unless
# this value is set, and every request must present it:
#
#     https://retention.digifyce.com/setup.php?token=<this value>
#
# Use at least 16 random characters. DELETE THIS LINE once setup is done -
# the page then refuses to do anything at all.
# ---------------------------------------------------------------------
SETUP_TOKEN=


# ---------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------
APP_BASE_URL=https://retention.digifyce.com

# Set to true ONLY while debugging. It prints errors to the browser.
APP_DEBUG=false


# ---------------------------------------------------------------------
# Alerting
#
# health_check.php emails here when a shard approaches its 3 GB limit,
# when the ingest spool backs up, or when a store's sync falls behind.
# Leave ALERT_EMAIL_TO blank to disable email (not recommended: a full
# shard silently drops events).
# ---------------------------------------------------------------------
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=


# ---------------------------------------------------------------------
# Shopify app credentials
#
# ONE app for every store - this is a public App Store app, not one custom
# app per merchant. Both values come from the Partner Dashboard under your
# app > Client credentials.
#
# SHOPIFY_REDIRECT_URI must match the Allowed redirection URL on the app
# EXACTLY, including scheme and path. Shopify refuses the install if it
# differs by so much as a trailing slash, and does not say which part.
#
# Scopes are NOT set here. They live in ShopifyOAuth::SCOPES and in
# shopify/shopify.app.toml, and the self-test checks the two agree.
# ---------------------------------------------------------------------
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_API_VERSION=2025-07
SHOPIFY_REDIRECT_URI=https://retention.digifyce.com/oauth/callback.php


# =====================================================================
# NOT configured here, on purpose:
#
#   secrets/master.key  — the AES key that encrypts stored Shopify
#     tokens. Generated by /setup.php (or bin/keygen.php with a shell),
#     never by hand. Back it up OFFLINE: losing it makes every stored
#     token permanently unrecoverable.
#
#   secrets/geoip-city.mmdb — IP-to-location database. Fetched by the setup
#     page (Step 5) straight to the server: DB-IP City Lite, CC-BY 4.0,
#     no account needed. The Geography tab must credit db-ip.com.
# =====================================================================


# ---------------------------------------------------------------------
# Retention after uninstall
#
# On the App Store merchants install, trial, and uninstall. Keeping their
# raw events forever is storage nobody pays for and personal data held with
# no relationship to justify it.
#
# UNINSTALL_PURGE_DAYS  days to wait after uninstall before deleting raw
#                       events. 0 deletes immediately. A shop/redact request
#                       from Shopify overrides this and deletes at once.
#
# KEEP_ROLLUPS_AFTER_UNINSTALL  rollups are anonymous counts, so keeping
#                       them is defensible and near-free - and a merchant
#                       who reinstalls still sees their old trend lines.
# ---------------------------------------------------------------------
UNINSTALL_PURGE_DAYS=0
KEEP_ROLLUPS_AFTER_UNINSTALL=true


# ---------------------------------------------------------------------
# The app's own public address
#
# Used wherever a URL has to be absolute and there is no request to read it
# from - notably the Shopify billing return URL. Leave it blank and the
# address is taken from the incoming request, which works in a browser and
# cannot work from cron.
#
# No trailing slash.
# ---------------------------------------------------------------------
APP_URL=https://retention.digifyce.com


# ---------------------------------------------------------------------
# Billing
#
# Shopify runs the subscription: it takes the trial, the money, the failed
# payment retries and the cancellation on uninstall. The app only reads the
# state back. A public app may not charge outside the Billing API, so there
# is nothing else to configure.
#
# BILLING_ENABLED   OFF by default, deliberately. An app that gates the
#                   dashboard before it is listed locks out its own test
#                   stores, and the first symptom is a blank page nobody can
#                   explain. Turn this on when the listing is ready.
#
# BILLING_TEST      Creates test subscriptions that bill nothing. This is
#                   what development and Shopify's own app review run on.
#                   MUST be false in production, or nobody is ever charged.
#
# BILLING_PRICE     A BUSINESS DECISION, not a technical one. Shopify bills
# BILLING_CURRENCY  in the currency set here, not the store's own.
#
# BILLING_TRIAL_DAYS  Nothing is charged during the trial and uninstalling
#                   cancels it, which is what merchants expect from the
#                   App Store.
#
# Tracking does NOT stop when billing lapses - only the dashboard is gated.
# A gap in history is permanent, and a merchant who subscribes two weeks
# after their trial ends should find those two weeks waiting for them.
# ---------------------------------------------------------------------
BILLING_ENABLED=false
BILLING_TEST=false
BILLING_PRICE=19.00
BILLING_CURRENCY=USD
BILLING_TRIAL_DAYS=14
