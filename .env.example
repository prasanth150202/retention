# =====================================================================
# Project Odysseus — environment configuration
#
# Copy this file to .env in the same directory and fill in the values.
# .env is gitignored and must NEVER be committed.
#
# This is the ONLY file the server admin needs to edit. Everything else
# is in version control.
#
# Location: repo root, i.e. ~/domains/retention.digifyce.com/.env
# This sits ABOVE public_html, so it is not web-reachable. Do not move it
# into public_html.
# =====================================================================


# ---------------------------------------------------------------------
# Database
#
# Hostinger prefixes every database name AND every database user with the
# account id, e.g. u123456789_. Create the databases in
# hPanel -> Databases, then put the prefix here.
#
# THREE databases are required to start:
#     <prefix>odys_core
#     <prefix>odys_ev_2026
#     <prefix>odys_ev_2027
#
# One MySQL user must be granted access to ALL of them. Cross-database
# queries fail at runtime if the user can only reach some.
# ---------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASS=
DB_PREFIX=

# Logical names. Leave these alone unless you know why you are changing them.
DB_CORE=odys_core
DB_SHARD_PATTERN=odys_ev_{year}


# ---------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------
APP_BASE_URL=https://retention.digifyce.com

# Set to true ONLY while debugging. It prints errors to the browser.
APP_DEBUG=false


# ---------------------------------------------------------------------
# Alerting
#
# health_check.php emails here when a shard approaches its 3 GB limit,
# when the ingest spool backs up, or when a store's sync falls behind.
# Leave ALERT_EMAIL_TO blank to disable email (not recommended: a full
# shard silently drops events).
# ---------------------------------------------------------------------
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=


# ---------------------------------------------------------------------
# Shopify — Partner Dashboard app credentials.
#
# Leave blank until the app exists. These are only needed for onboarding
# a store via OAuth (M2); ingest and the dashboard work without them.
#
# SHOPIFY_REDIRECT_URI must match the Allowed redirection URL in the
# Partner Dashboard app config EXACTLY, including scheme and path.
# ---------------------------------------------------------------------
SHOPIFY_API_VERSION=2025-07
SHOPIFY_REDIRECT_URI=https://retention.digifyce.com/oauth/callback.php


# =====================================================================
# NOT configured here, on purpose:
#
#   secrets/master.key  — the AES key that encrypts stored Shopify
#     tokens. Generate it with `php bin/keygen.php`, never by hand.
#     Back it up OFFLINE: losing it makes every stored token
#     permanently unrecoverable.
#
#   secrets/GeoLite2-City.mmdb — MaxMind geo database. Download with a
#     free MaxMind account and place it in secrets/.
# =====================================================================
