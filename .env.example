# =====================================================================
# Project Odysseus — environment configuration
#
# Copy this file to .env in the same directory and fill in the values.
# .env is gitignored and must NEVER be committed.
#
# This is the ONLY file the server admin needs to edit. Everything else
# is in version control.
#
# Location: repo root, i.e. ~/domains/retention.digifyce.com/.env
# This sits ABOVE public_html, so it is not web-reachable. Do not move it
# into public_html.
# =====================================================================


# ---------------------------------------------------------------------
# Database
#
# Create THREE databases in hPanel -> Databases. Hostinger prepends your
# account id to whatever name you type, and shows you the full result:
#
#     odys_core       ->  u123456789_odys_core
#     odys_ev_2026    ->  u123456789_odys_ev_2026
#     odys_ev_2027    ->  u123456789_odys_ev_2027
#
# Create ONE database user and grant it access to ALL THREE. This matters:
# the application runs queries that span databases, and they fail at
# runtime if the user can only reach some of them.
# ---------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASS=

# Full database names, exactly as hPanel shows them (including the account
# prefix). Copy and paste them.
#
#   DB_CORE   the permanent database: stores, orders, customers, reports
#   DB_SHARD  raw pixel events, which get a NEW database every year because
#             Hostinger caps each one at 3 GB. Keep the literal {year} in
#             this value - the application substitutes it to work out which
#             database a given date belongs to, and to check whether next
#             year's exists yet.
#
# Example, if your account prefix is u123456789_ :
#   DB_CORE=u123456789_odys_core
#   DB_SHARD=u123456789_odys_ev_{year}
#
DB_CORE=
DB_SHARD=


# ---------------------------------------------------------------------
# Per-shard credentials
#
# Hostinger issues ONE credential per database, so each yearly events
# database normally has its own user and password. Add a block per year:
#
#   DB_SHARD_2026_USER=u123456789_ev26
#   DB_SHARD_2026_PASS=...
#
# Optionally override the name too, if the database ended up called
# something that does not match the DB_SHARD pattern:
#
#   DB_SHARD_2026_NAME=u123456789_events_2026
#
# If a year has no block here, the application falls back to DB_USER /
# DB_PASS above. That covers hosts which allow one user across several
# databases.
#
# The databases do NOT need to share a user. No query ever JOINs across
# databases: event rows store only integer ids, and the names they point
# at live in DB_CORE, so each database is read on its own connection.
# ---------------------------------------------------------------------


# ---------------------------------------------------------------------
# Setup token
#
# Only needed on hosts with no shell access, where the one-time setup steps
# have to run through the browser at /setup.php instead of the command line.
#
# That page can create files and change the database, so it is INERT unless
# this value is set, and every request must present it:
#
#     https://retention.digifyce.com/setup.php?token=<this value>
#
# Use at least 16 random characters. DELETE THIS LINE once setup is done -
# the page then refuses to do anything at all.
# ---------------------------------------------------------------------
SETUP_TOKEN=


# ---------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------
APP_BASE_URL=https://retention.digifyce.com

# Set to true ONLY while debugging. It prints errors to the browser.
APP_DEBUG=false


# ---------------------------------------------------------------------
# Alerting
#
# health_check.php emails here when a shard approaches its 3 GB limit,
# when the ingest spool backs up, or when a store's sync falls behind.
# Leave ALERT_EMAIL_TO blank to disable email (not recommended: a full
# shard silently drops events).
# ---------------------------------------------------------------------
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=


# ---------------------------------------------------------------------
# Shopify — Partner Dashboard app credentials.
#
# Leave blank until the app exists. These are only needed for onboarding
# a store via OAuth (M2); ingest and the dashboard work without them.
#
# SHOPIFY_REDIRECT_URI must match the Allowed redirection URL in the
# Partner Dashboard app config EXACTLY, including scheme and path.
# ---------------------------------------------------------------------
SHOPIFY_API_VERSION=2025-07
SHOPIFY_REDIRECT_URI=https://retention.digifyce.com/oauth/callback.php


# =====================================================================
# NOT configured here, on purpose:
#
#   secrets/master.key  — the AES key that encrypts stored Shopify
#     tokens. Generate it with `php bin/keygen.php`, never by hand.
#     Back it up OFFLINE: losing it makes every stored token
#     permanently unrecoverable.
#
#   secrets/GeoLite2-City.mmdb — MaxMind geo database. Download with a
#     free MaxMind account and place it in secrets/.
# =====================================================================
