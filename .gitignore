# ---------------------------------------------------------------------
# Environment — the ONLY file the server admin edits. Holds the database
# credentials. Never commit it; .env.example is the tracked template.
#
# .env.* is covered too, so per-environment files like .env.production
# cannot be committed by accident. .env.example is the one exception.
# ---------------------------------------------------------------------
.env
.env.*
!.env.example

# ---------------------------------------------------------------------
# Secrets. Losing secrets/master.key makes every stored Shopify Admin API
# token permanently unrecoverable — back it up OFFLINE, not here.
# ---------------------------------------------------------------------
secrets/
*.key
*.key.*.bak
*.pem
*.mmdb
token.json

# ---------------------------------------------------------------------
# Runtime state, created on the server outside the document root. Spool
# files contain visitor data, so they are deliberately untracked.
# ---------------------------------------------------------------------
storage/

# ---------------------------------------------------------------------
# Local
# ---------------------------------------------------------------------
.DS_Store
._*
Thumbs.db
*.log
.idea/
.vscode/
*.swp

# ---------------------------------------------------------------------
# Shopify CLI project. The TOML and extension source are tracked; the
# toolchain is not. Node exists on a developer's laptop to run
# `shopify app deploy` and nowhere else — nothing here is deployed to the
# PHP server.
# ---------------------------------------------------------------------
shopify/node_modules/
shopify/.shopify/
shopify/dist/
shopify/**/node_modules/
shopify/**/dist/
